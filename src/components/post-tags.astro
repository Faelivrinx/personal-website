---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <div class="flex flex-wrap items-center gap-2 w-full max-w-2xl mx-auto mt-6 mb-8 md:mb-12">
      <svg
        class="w-4 h-4 text-neutral-600 dark:text-neutral-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
        />
      </svg>
      {tags.map((tag) => (
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors">
          {tag}
        </span>
      ))}
    </div>
  )
}
